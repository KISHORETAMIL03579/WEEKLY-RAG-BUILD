# ── Ask My Docs — Environment Configuration Template ───────────────────────
# Copy this file to `.env` in the project root (same folder as app.py).
# NEVER commit a real .env or expose credentials in logs, issues, or chats.

# ── Chat, policy agent & workflow: Groq ────────────────────────────────────
# Chat answers, the Week 7 agent/workflow, the Week 8 trajectory evaluation and the
# Week 9 MCP host all call Groq (OpenAI-compatible tool calling). Use a rotated key.
CHAT_BACKEND=groq
GROQ_API_KEY=
GROQ_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Comma-separated allowlist of Groq models offered for tool calling.
GROQ_AGENT_MODELS=openai/gpt-oss-20b
# (xAI and Ollama chat backends still exist for the plain chat page; the policy agent
#  and workflow require CHAT_BACKEND=groq.)
XAI_API_KEY=
XAI_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3
OLLAMA_CHAT_MODEL=llama3.1:8b

# ── Embeddings (document chunks -> Qdrant) ─────────────────────────────────
# Groq has NO embeddings API, so pick how chunks are indexed:
#   none   = lexical mode. Chunks are stored in Qdrant and searched with BM25; chat and the
#            policy tools still use Groq. Needs nothing else running. (Recommended with Groq only.)
#   ollama = semantic hybrid search with a local model (ollama pull nomic-embed-text; ollama serve)
#   gemini = semantic hybrid search via Google (needs GEMINI_API_KEY)
EMBED_BACKEND=none
# Image OCR backend (only used for image uploads).
VISION_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001
GEMINI_VISION_MODEL=gemini-3.7-flash
# Query-embedding guard for semantic mode: fail fast, then search lexically for a while.
EMBED_QUERY_TIMEOUT_SECONDS=8
EMBED_COOLDOWN_SECONDS=60

# ── Policy agent budgets (hard ceilings; a request may lower but never raise them) ──
POLICY_MAX_ITERATIONS=6
POLICY_MAX_TOKENS=24000
POLICY_MAX_COST_USD=0.05
POLICY_MAX_WALL_CLOCK_SECONDS=60

# ── MCP host (Week 9) ──────────────────────────────────────────────────────
# Tool servers are declared in this file; adding one is a config change, not a code change.
MCP_CONFIG_PATH=config/mcp_servers.json
# Retries per tool call for transient failures (transport errors, retryable tool errors).
MCP_TOOL_MAX_RETRIES=2
MCP_TOOL_RETRY_BACKOFF_SECONDS=0.2
MCP_TOOL_TIMEOUT_SECONDS=30
# One JSON line per tools/call (caller, tool, employee id, attempts, outcome).
MCP_AUDIT_LOG_PATH=traces/mcp_audit.jsonl
# Data file read by the stand-in HRIS server (replace with your HRIS export).
# HRIS_DATA_PATH=backend/data/samples/hris_records.json

# ── Retrieval Tuning ───────────────────────────────────────────────────────
# Minimum score threshold on RRF normalized scale (0.0 to 1.0) before answering.
EMBED_MIN_SCORE=0.55

# Retrieval mode: "hybrid" (BM25 + embeddings via RRF), "hybrid-legacy", or "embed"
RETRIEVAL_MODE=hybrid

# Weight on embeddings in hybrid-legacy mode (0.0 - 1.0; unused by RRF).
HYBRID_ALPHA=0.6

# Reciprocal Rank Fusion smoothing constant.
# Tuned for the document-sized corpus used by this application.
RRF_K=10

# BM25 term-frequency saturation and length-normalization constants.
BM25_K1=1.5
BM25_B=0.75

# Number of candidate chunks retrieved before token budget capping.
TOP_K=8

# Maximum context token budget sent to the LLM per query.
MAX_CONTEXT_TOKENS=6000

# ── Chunking Strategy Defaults ─────────────────────────────────────────────
# Default strategy ("structured" or "fixed") and fixed chunk word count.
DEFAULT_CHUNK_MODE=structured
DEFAULT_CHUNK_SIZE=512

# ── Reranking (Second-Pass Relevance Judgment) ─────────────────────────────
# Off by default. Sends candidate chunks to LLM for 0-10 relevance scoring.
RERANK_ENABLED=false
RERANK_TOP_N=8
RERANK_MIN_RELEVANCE=5

# ── Query Rewriting ────────────────────────────────────────────────────────
# Off by default. Uses LLM to formulate an optimized search query.
QUERY_REWRITE_ENABLED=false

# ── Vector DB Backend ──────────────────────────────────────────────────────
# Options: "qdrant" (vector database) or "memory" (in-process fallback).
VECTOR_BACKEND=qdrant

# Qdrant cluster endpoint.
# Leave empty for local Docker Compose (defaults to http://qdrant:6333).
# For Qdrant Cloud, set this to your cluster URL.
QDRANT_URL=

# Qdrant Cloud API key.
# Required when connecting to a secured Qdrant Cloud cluster.
QDRANT_API_KEY=

# Request timeout in seconds.
QDRANT_TIMEOUT=10

# Candidate pool size retrieved from Qdrant prior to hybrid re-ranking.
QDRANT_CANDIDATE_POOL=30

# ── Trace Logging ──────────────────────────────────────────────────────────
# Destination JSONL path for durable, audited /ask trace records.
TRACE_LOG_PATH=traces/traces.jsonl

# Local SQLite file for session metadata and cross-worker evaluation/chat state.
# Docker Compose uses its persistent app_state volume instead.
APP_STATE_DB=vectorstore/app_state.sqlite3

# ── Security / Ops ─────────────────────────────────────────────────────────
# Session cookie signing key (Starlette SessionMiddleware, itsdangerous-signed).
# Required for production deployments to preserve sessions across restarts.
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Deployment mode. Set to "production" to make SECRET_KEY mandatory (the app
# refuses to boot with an ephemeral per-process key). ENV / FLASK_ENV are
# still honored as legacy aliases.
# APP_ENV=production

# Adds the Secure flag to the session cookie. Enable ONLY when TLS terminates
# in front of the app — browsers drop Secure cookies over plain HTTP, which
# breaks login rather than hardening it.
SESSION_COOKIE_SECURE=false

# Admin API authentication key.
# Required when accessing admin endpoints (e.g. GET /orphans?all=true or cross-session replay).
# Leave empty if admin endpoints are not being used.
ADMIN_API_KEY=

# Logging verbosity: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000

# Local development:
HOST=127.0.0.1

# Docker/container deployments should use:
# HOST=0.0.0.0

# Enables uvicorn's autoreloader + debug logging on `python app.py`.
# Keep false in production.
APP_DEBUG=false
