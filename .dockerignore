# Secrets — never send these to the Docker daemon as build context.
.env
.env.*
!.env.example

# Version control
.git
.gitignore

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Runtime data — these are volume-mounted at run time (see docker-compose.yml),
# not baked into the image. Excluding them keeps the build context small and
# avoids ever accidentally shipping real uploaded documents, vectors, or trace
# logs (even redacted ones) inside an image layer.
uploads/
vectorstore/
traces/
state/
benchmarks/policy_execution/runs/
benchmarks/policy_execution/trajectory_*.json
benchmarks/policy_execution/trajectory_*.partial
scratch/

# Dependencies and build output (rebuilt inside the image)
node_modules/
frontend/node_modules/
frontend/dist/

# Not needed at runtime
tests/
docs/
WEEKLY_RAG_TASK/

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
server.log
server.err.log

# Testing & code quality caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# CI & metadata
.github/
*.md

# Container configurations
Dockerfile*
docker-compose*.yaml
docker-compose*.yml
